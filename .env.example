# ==============================================================================
# VerifyID AI Platform — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Gateway Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Database Configuration
# Local zero-config SQLite:
DATABASE_URL=sqlite:./data/identity_verification.sqlite
# Production PostgreSQL:
# DATABASE_URL=postgresql://verifyid_admin:change_me_to_a_secure_password@127.0.0.1:5432/identity_verification

# Docker Compose PostgreSQL credentials
POSTGRES_USER=verifyid_admin
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=identity_verification

# Downstream AI Verification Service
AI_SERVICE_URL=http://127.0.0.1:8001

# Security & Secrets (MUST be changed in production)
JWT_SECRET=dev_insecure_jwt_secret_key_change_in_production_2026
PII_SALT=dev_insecure_pii_salt_key_change_in_production_2026
CORS_ORIGIN=http://localhost:3000

# Default Seed Credentials (Optional overrides)
SEED_ADMIN_EMAIL=admin@verifyid.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_REVIEWER_EMAIL=reviewer@verifyid.local
SEED_REVIEWER_PASSWORD=Reviewer@12345

# ------------------------------------------------------------------------------
# AI Service & Cloud OCR Settings
# ------------------------------------------------------------------------------
# Optional AWS Textract credentials (if omitted, falls back to local Tesseract OCR)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local Tesseract Binary Path (Optional override if not in PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=
